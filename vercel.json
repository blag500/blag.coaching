{
  "rewrites": [
    {
      "source": "/cheatcode/",
      "destination": "/cheatcode/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/cheatcode",
      "destination": "/cheatcode/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/cheatcode/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/cheatcode/"
        }
      ]
    }
  ]
}
