{
  "rewrites": [
    {
      "source": "/cheatcode/",
      "destination": "/cheatcode/index.html"
    },
    {
      "source": "/invest/",
      "destination": "/invest/index.html"
    },
    {
      "source": "/tablo/",
      "destination": "/tablo/index.html"
    },
    {
      "source": "/shop/",
      "destination": "/shop/index.html"
    },
    {
      "source": "/cokitchen/",
      "destination": "/cokitchen/index.html"
    },
    {
      "source": "/vhod/",
      "destination": "/vhod/index.html"
    },
    {
      "source": "/svyat/",
      "destination": "/svyat/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/cheatcode",
      "destination": "/cheatcode/",
      "permanent": false
    },
    {
      "source": "/invest",
      "destination": "/invest/",
      "permanent": false
    },
    {
      "source": "/tablo",
      "destination": "/tablo/",
      "permanent": false
    },
    {
      "source": "/shop",
      "destination": "/shop/",
      "permanent": false
    },
    {
      "source": "/cokitchen",
      "destination": "/cokitchen/",
      "permanent": false
    },
    {
      "source": "/vhod",
      "destination": "/vhod/",
      "permanent": false
    },
    {
      "source": "/svyat",
      "destination": "/svyat/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/cheatcode/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/cheatcode/"
        }
      ]
    }
  ]
}
